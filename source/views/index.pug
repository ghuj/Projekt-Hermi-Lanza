  section#contact
    h1.section-header CONTACT
    .contact-wrapper
      //
        --------------
        CONTACT PAGE LEFT
        ---------------
      form.form-horizontal(method='post' action='mail.php')
        .form-group
          .col-sm-12
            input#name.form-control(type='text' placeholder='NAME' name='name' value='')
        .form-group
          .col-sm-12
